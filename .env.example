# Database
DATABASE_URL=postgresql+psycopg://user:password@db:5432/converter

# Redis
REDIS_URL=redis://redis:6379/0

# S3 / R2 (MinIO locally, Cloudflare R2 in prod)
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=converter-bucket
S3_REGION=us-east-1

# App
APP_ENV=development
SECRET_KEY=super-secret-key-change-in-prod

# Guest sessions (optional, defaults shown)
GUEST_EMAIL_DOMAIN=guest.local
GUEST_FILE_TTL_HOURS=24
GUEST_PURGE_DAYS=7
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional
# SENTRY_DSN=
# MALWARE_SCAN_ENDPOINT=